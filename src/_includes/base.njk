<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="icon" href="{{ '/images/favicon.svg' | url }}" type="image/svg+xml">
<!-- Lets "加入主畫面" produce a proper home-screen icon and launch in
     standalone mode instead of a Safari-chrome window. -->
<link rel="apple-touch-icon" href="{{ '/images/apple-touch-icon.png' | url }}">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="阿蕭跟老郭">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/css/tokens.css' | url }}">
<link rel="stylesheet" href="{{ '/css/base.css' | url }}">
<link rel="stylesheet" href="{{ '/css/components.css' | url }}">
<link rel="stylesheet" href="{{ '/css/pages.css' | url }}">
<noscript><style>.reveal{opacity:1!important;transform:none!important}</style></noscript>
<script>(function(){var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);})();</script>
<script type="importmap">
{"imports": {"@material/web/": "https://esm.run/@material/web@2.5.0/"}}
</script>
<script type="module">
  // A single @material/web/all.js entry point is used deliberately, not the
  // ~16 individual component imports: jsDelivr/esm.run bundles each entry
  // point separately and does not dedupe shared internal sub-components
  // (e.g. <md-elevation>, used internally by many components) across
  // separate bundles, so importing several entry points side by side
  // throws "the name md-elevation has already been used" and aborts.
  // Loading the one combined bundle avoids the duplicate registration.
  import '@material/web/all.js';
  import {styles as typescaleStyles} from '@material/web/typography/md-typescale-styles.js';
  document.adoptedStyleSheets = [...document.adoptedStyleSheets, typescaleStyles.styleSheet];
</script>
{% block extraHead %}{% endblock %}
</head>
<body data-page="{{ pageKey }}" data-latest-diary="{{ latestDiaryDate }}" data-latest-gallery="{{ latestGalleryDate }}" data-latest-about="{{ latestAboutDate }}">
  {% block progressBar %}{% endblock %}
  <div class="app-shell">
    <div id="site-nav-side"></div>
    <div class="content-column">
      <div id="site-nav-top"></div>
      <main class="page-content">
        <div class="container">

          {% block content %}{% endblock %}

        </div>
      </main>
    </div>
  </div>
  <div id="site-nav-bottom"></div>

  <div id="site-footer"></div>

  {% block afterFooter %}{% endblock %}

  <script>window.SITE_ROOT = "{{ '/' | url }}";</script>
  <script src="{{ '/js/nav.js' | url }}"></script>
  <script src="{{ '/js/theme.js' | url }}"></script>
  <script src="{{ '/js/motion.js' | url }}"></script>
  {% block extraScripts %}{% endblock %}
</body>
</html>
