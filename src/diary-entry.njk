---
pagination:
  data: diary
  size: 1
  alias: entry
  addAllPagesToCollections: true
permalink: "diary/{{ entry.slug }}.html"
eleventyComputed:
  title: "{{ entry.title }} — 老蕭跟心寶的生活記錄"
  description: "{{ entry.description }}"
pageKey: diary
---
{% extends "base.njk" %}
{% block progressBar %}
<md-linear-progress id="reading-progress" value="0" aria-label="閱讀進度"></md-linear-progress>
{% endblock %}
{% block content %}

<md-text-button class="entry-back" href="{{ '/diary.html' | url }}">
  <svg slot="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.8l5.6-5.6L12 4l-8 8 8 8 1.4-1.4L7.8 13H20z"/></svg>
  返回日記列表
</md-text-button>

<div class="entry-hero reveal">
  <img src="{{ entry.heroImage | url }}" alt="{{ entry.imageAlt }}" style="width:100%;height:100%;object-fit:cover">
</div>

<article class="entry-article reveal">
  <header class="entry-header">
    <div class="entry-meta">
      <span class="md-label-large" style="color:var(--md-sys-color-primary)">{{ categories.diary[entry.category] }}</span>
      <span class="md-body-medium md-on-surface-variant">{{ entry.longDate }}</span>
    </div>
    <h1 class="md-headline-large is-emphasized">{{ entry.title }}</h1>
  </header>

  <div class="entry-body">{{ entry.bodyHtml | fixLocalImages | safe }}</div>
</article>

{% set prevEntry = diary[pagination.pageNumber + 1] %}
{% set nextEntry = diary[pagination.pageNumber - 1] %}
<nav class="entry-nav" aria-label="上一篇 / 下一篇">
  {% if prevEntry %}
  <a class="elevation-surface is-flat" href="{{ ('/diary/' + prevEntry.slug + '.html') | url }}">
    <md-ripple></md-ripple>
    <span class="md-label-medium md-on-surface-variant">上一篇</span>
    <span class="md-title-medium">{{ prevEntry.title }}</span>
  </a>
  {% else %}<span></span>{% endif %}
  {% if nextEntry %}
  <a class="next elevation-surface is-flat" href="{{ ('/diary/' + nextEntry.slug + '.html') | url }}">
    <md-ripple></md-ripple>
    <span class="md-label-medium md-on-surface-variant">下一篇</span>
    <span class="md-title-medium">{{ nextEntry.title }}</span>
  </a>
  {% else %}<span></span>{% endif %}
</nav>

{% endblock %}
{% block extraScripts %}
<script>
  (function () {
    var bar = document.getElementById('reading-progress');
    var article = document.querySelector('.entry-article');
    if (!bar || !article) return;
    var update = function () {
      var start = article.offsetTop;
      var total = article.offsetHeight - window.innerHeight;
      if (total <= 0) { bar.value = 1; return; }
      var scrolled = window.scrollY - start + window.innerHeight * 0.5;
      bar.value = Math.min(1, Math.max(0, scrolled / total));
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>
{% endblock %}
